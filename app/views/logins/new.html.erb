<% content_for :title, "Sign in · FinanSheet" %>

<div class="login-page">
  <div class="login-card">
    <%= image_tag "logo.svg", alt: "FinanSheet", class: "login-logo" %>

    <form data-controller="login-form" data-action="submit->login-form#submit" novalidate>
      <div data-login-form-target="error" class="error-message" hidden></div>

      <label>
        Email
        <input type="email" name="email" data-login-form-target="email" required autocomplete="email">
      </label>

      <label>
        Password
        <input type="password" name="password" data-login-form-target="password" required autocomplete="current-password">
      </label>

      <label class="checkbox-label">
        <input type="checkbox" name="remember_me" data-login-form-target="rememberMe">
        Remember me
      </label>

      <button type="submit" data-login-form-target="submit">Sign in</button>

      <a href="#" class="forgot-password">Forgot password?</a>
    </form>
  </div>
</div>
