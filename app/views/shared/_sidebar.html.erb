<aside class="sidebar" data-controller="sidebar">
  <button type="button"
          class="sidebar-toggle"
          data-action="click->sidebar#toggle"
          aria-label="Toggle menu">
    <svg viewBox="0 0 24 24" width="22" height="22" fill="none"
         stroke="currentColor" stroke-width="2"
         stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <line x1="3" y1="6"  x2="21" y2="6"/>
      <line x1="3" y1="12" x2="21" y2="12"/>
      <line x1="3" y1="18" x2="21" y2="18"/>
    </svg>
  </button>

  <div class="sidebar-backdrop" data-action="click->sidebar#close"></div>

  <div class="sidebar-panel">
    <div class="sidebar-brand">
      <%= image_tag "logo.svg", alt: "FinanSheet" %>
    </div>

    <div class="sidebar-user" data-sidebar-target="user">
      <div class="sidebar-avatar" data-sidebar-target="avatar" aria-hidden="true">?</div>
      <div class="sidebar-user__info">
        <div class="sidebar-email"  data-sidebar-target="email">—</div>
        <div class="sidebar-salary" data-sidebar-target="salary" hidden></div>
      </div>
    </div>

    <nav class="sidebar-nav" aria-label="Main">
      <%# Links futuros entram aqui. Por enquanto fica vazio. %>
    </nav>

    <div class="sidebar-footer">
      <button type="button"
              class="sidebar-logout"
              data-action="click->sidebar#logout">
        <svg viewBox="0 0 24 24" width="18" height="18" fill="none"
             stroke="currentColor" stroke-width="2"
             stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"/>
          <polyline points="16 17 21 12 16 7"/>
          <line x1="21" y1="12" x2="9" y2="12"/>
        </svg>
        Sign out
      </button>
    </div>
  </div>
</aside>
