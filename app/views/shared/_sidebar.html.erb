<aside class="sidebar" data-controller="sidebar">
  <button type="button"
          class="sidebar-toggle"
          data-action="click->sidebar#toggle"
          aria-label="Toggle menu">
    <svg viewBox="0 0 24 24" width="22" height="22" fill="none"
         stroke="currentColor" stroke-width="2"
         stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <line x1="3" y1="6"  x2="21" y2="6"/>
      <line x1="3" y1="12" x2="21" y2="12"/>
      <line x1="3" y1="18" x2="21" y2="18"/>
    </svg>
  </button>

  <div class="sidebar-backdrop" data-action="click->sidebar#close"></div>

  <div class="sidebar-panel">
    <div class="sidebar-brand">
      <%= image_tag "logo.svg", alt: "FinanSheet" %>
    </div>

    <div class="sidebar-user" data-sidebar-target="user">
      <div class="sidebar-avatar" data-sidebar-target="avatar" aria-hidden="true">?</div>
      <div class="sidebar-user__info">
        <div class="sidebar-email"  data-sidebar-target="email">—</div>
        <div class="sidebar-salary" data-sidebar-target="salary" hidden></div>
      </div>
    </div>

    <nav class="sidebar-nav" aria-label="Main">
      <%# Links futuros entram aqui. Por enquanto fica vazio. %>
    </nav>

    <%# Resumo do ciclo. Componente independente: ouve "cycle:summary-update"
        do cards_controller e renderiza A receber + cartões + Saldo. %>
    <section class="sidebar-cycle" data-controller="cycle-summary"
             data-cycle-summary-target="root" hidden>
      <header class="sidebar-cycle__header">
        <h2 class="sidebar-cycle__title">Resumo do ciclo</h2>
        <span class="sidebar-cycle__month" data-cycle-summary-target="month">—</span>
      </header>
      <ul class="sidebar-cycle__lines" data-cycle-summary-target="lines"></ul>
      <footer class="sidebar-cycle__footer">
        <span>Saldo</span>
        <strong class="sidebar-cycle__balance" data-cycle-summary-target="balance">R$ 0,00</strong>
      </footer>
    </section>

    <%# Contas Fixas — resumo na sidebar. Componente próprio que faz suas
        próprias requests. Botão "Ver detalhes" abre modal dedicado. %>
    <section class="sidebar-fixed" data-controller="fixed-expenses-summary"
             data-fixed-expenses-summary-target="root" hidden>
      <header class="sidebar-fixed__header">
        <h2 class="sidebar-fixed__title">Contas Fixas</h2>
      </header>
      <ul class="sidebar-fixed__lines">
        <li class="sidebar-fixed__line">
          <span>Total</span>
          <strong data-fixed-expenses-summary-target="total">R$ 0,00</strong>
        </li>
        <li class="sidebar-fixed__line sidebar-fixed__line--paid">
          <span>Pagas</span>
          <strong data-fixed-expenses-summary-target="paid">R$ 0,00</strong>
        </li>
        <li class="sidebar-fixed__line sidebar-fixed__line--pending"
            data-fixed-expenses-summary-target="pendingRow" hidden>
          <span>Pendentes</span>
          <strong data-fixed-expenses-summary-target="pending">R$ 0,00</strong>
        </li>
      </ul>
      <button type="button" class="sidebar-fixed__action"
              data-action="click->fixed-expenses-summary#openModal">
        <svg viewBox="0 0 24 24" width="16" height="16" fill="none"
             stroke="currentColor" stroke-width="2" stroke-linecap="round"
             stroke-linejoin="round" aria-hidden="true">
          <line x1="8" y1="6"  x2="21" y2="6"/>
          <line x1="8" y1="12" x2="21" y2="12"/>
          <line x1="8" y1="18" x2="21" y2="18"/>
          <circle cx="4" cy="6"  r="1"/>
          <circle cx="4" cy="12" r="1"/>
          <circle cx="4" cy="18" r="1"/>
        </svg>
        Ver detalhes
      </button>
    </section>

    <div class="sidebar-footer">
      <button type="button"
              class="sidebar-logout"
              data-action="click->sidebar#logout">
        <svg viewBox="0 0 24 24" width="18" height="18" fill="none"
             stroke="currentColor" stroke-width="2"
             stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"/>
          <polyline points="16 17 21 12 16 7"/>
          <line x1="21" y1="12" x2="9" y2="12"/>
        </svg>
        Sign out
      </button>
    </div>
  </div>
</aside>
